# --- secrets: never commit ---
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
secrets*.json

# --- local state (journal DB, eval cache, traces) ---
state/

# --- run logs: only the final scored run's log is committed, with `git add -f` ---
logs/*.jsonl
*.db
*.sqlite
*.sqlite3

# --- python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# --- node / cloudflare ---
node_modules/
.wrangler/

# --- os / editors ---
.DS_Store
Thumbs.db
.idea/